# DevFlow Backend — Phase 3/4 environment template
# Copy to backend/.env (never commit real secrets)
#
# Phase 4: project-service (:8084), DB devflow_project, topic project-events
# Frontend optional live API (in frontend/.env.local — do not commit secrets):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
#   NEXT_PUBLIC_USE_PROJECT_API=true
#   NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
#   NEXT_PUBLIC_KEYCLOAK_REALM=devflow
#   NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=devflow-web
#   (never put client secrets in NEXT_PUBLIC_*)

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
DB_USERNAME=devflow
DB_PASSWORD=devflow
# Host port for Docker → local apps. Avoid 15432 on Windows (Hyper-V reserved range).
POSTGRES_PORT=5432

# MongoDB
MONGO_USERNAME=devflow
MONGO_PASSWORD=devflow
MONGO_PORT=27017
MONGODB_URI=mongodb://devflow:devflow@localhost:27017/devflow_document?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Keycloak / OIDC / JWT
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_PORT=8180
# Local Keycloak admin (docker) — override; never commit real production values
KEYCLOAK_ADMIN=devflow-kc-admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe-LocalOnly-Keycloak!
KEYCLOAK_REALM=devflow
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/devflow
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/devflow/protocol/openid-connect/certs
KEYCLOAK_WEB_CLIENT_ID=devflow-web
KEYCLOAK_CLIENT_ID=devflow-web
# Optional resource-server audience hardening (aud or azp)
# KEYCLOAK_AUDIENCES=devflow-web
KEYCLOAK_ADMIN_CLIENT_ID=devflow-gateway
KEYCLOAK_ADMIN_CLIENT_SECRET=devflow-gateway-secret-change-me
KEYCLOAK_ADMIN_API_ENABLED=false
# Optional SMTP for Keycloak email verification / reset (never commit real passwords)
# KEYCLOAK_SMTP_HOST=
# KEYCLOAK_SMTP_PORT=587
# KEYCLOAK_SMTP_USER=
# KEYCLOAK_SMTP_PASSWORD=
# KEYCLOAK_SMTP_FROM=
# KEYCLOAK_SMTP_STARTTLS=true

# Gateway
GATEWAY_PORT=8080
RATE_LIMIT_REPLENISH=50
RATE_LIMIT_BURST=100

# Service URLs (local process mode)
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
ORGANIZATION_SERVICE_URL=http://localhost:8083
PROJECT_SERVICE_URL=http://localhost:8084
TASK_SERVICE_URL=http://localhost:8085
SPRINT_SERVICE_URL=http://localhost:8086
DOCUMENT_SERVICE_URL=http://localhost:8087
REPOSITORY_SERVICE_URL=http://localhost:8088
DEPLOYMENT_SERVICE_URL=http://localhost:8089
NOTIFICATION_SERVICE_URL=http://localhost:8090
ANALYTICS_SERVICE_URL=http://localhost:8091
AUDIT_SERVICE_URL=http://localhost:8092
