# Used by Docker Compose for ${VAR} interpolation in this folder.
# Copy to `.env` next to docker-compose.yml (gitignored).
# Keep POSTGRES_PORT in sync with backend/.env.
#
# Do not use host port 15432 on Windows — Hyper-V often reserves
# 15392–15491 and Docker cannot bind that port.
POSTGRES_PORT=5432
DB_USERNAME=devflow
DB_PASSWORD=devflow
MONGO_USERNAME=devflow
MONGO_PASSWORD=devflow
MONGO_PORT=27017
REDIS_PORT=6379
KAFKA_PORT=9092
KEYCLOAK_PORT=8280
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_SECRET=devflow-gateway-secret-change-me
FRONTEND_URL=http://localhost:3000
GATEWAY_PORT=8080
